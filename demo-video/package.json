    "@remotion/media-utils": "^4.0.140",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.140"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
