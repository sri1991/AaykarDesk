{
  "name": "aaykardesk-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion pitch video for AaykarDesk (1920x1080, 90s, 30fps)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
